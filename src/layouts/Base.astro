---
const { title, description, canonical, jsonld = [] } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = canonical ?? site + Astro.url.pathname;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="ar_SA" />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@500;700&family=IBM+Plex+Sans+Arabic:wght@400;500&display=swap" rel="stylesheet" />
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
:root{
  --night:#15213B; --night-2:#22335A; --sand:#F5EFE3; --paper:#FFFFFF; --ink:#1D2433; --mute:#6B7385;
  --line:#E4E0D6; --gold:#C9962B; --gold-2:#A87A1D; --ring:#2F7E8B;
  --fd:'Alexandria',system-ui,sans-serif; --fb:'IBM Plex Sans Arabic',system-ui,sans-serif;
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;font-family:var(--fb);color:var(--ink);background:var(--paper);line-height:1.75;font-size:17px}
h1,h2,h3{font-family:var(--fd);line-height:1.3;margin:0 0 .5em;color:var(--night)}
h1{font-size:clamp(1.7rem,4vw,2.6rem);font-weight:700}
h2{font-size:1.35rem;font-weight:700;margin-top:2.2rem}
a{color:var(--night-2)}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.top{background:var(--night);color:#fff;padding:14px 0;font-size:.95rem}
.top .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px}
.top a{color:#fff;text-decoration:none}
.brand{font-family:var(--fd);font-weight:700;font-size:1.15rem;letter-spacing:.2px}
.brand b{color:var(--gold)}
.crumbs{font-size:.9rem;color:var(--mute);padding:18px 0 4px}
.crumbs a{color:var(--mute);text-decoration:none}
.crumbs span{margin:0 .4em}
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:28px;align-items:start;padding:12px 0 8px}
@media(max-width:820px){.hero{grid-template-columns:1fr}}
.lede{font-size:1.08rem;color:#2d3550}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0}
.chip{background:var(--sand);border:1px solid var(--line);border-radius:999px;padding:5px 13px;font-size:.88rem;color:var(--night)}
.chip.ring{background:#E6F2F4;border-color:#BFDDE2;color:var(--ring)}
.map{position:relative;aspect-ratio:4/3;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:var(--sand)}
.map .leaflet-container{height:100%;width:100%;font-family:var(--fb)}
.map .ringlabel{position:absolute;top:12px;inset-inline-start:12px;z-index:500;background:var(--night);color:#fff;border-radius:10px;padding:6px 12px;font-size:.85rem;font-family:var(--fd)}
.book{margin:26px 0 6px;background:var(--night);color:#fff;border-radius:18px;padding:20px 22px;display:grid;grid-template-columns:repeat(4,1fr) auto;gap:14px;align-items:end}
@media(max-width:820px){.book{grid-template-columns:1fr 1fr}.book .cta{grid-column:1/-1}}
.book label{display:block;font-size:.78rem;color:#C9D1E6;margin-bottom:4px}
.book input,.book select{width:100%;border:1px solid #3A4B73;background:var(--night-2);color:#fff;border-radius:10px;padding:10px;font-family:var(--fb);font-size:.95rem}
.cta{display:inline-block;background:var(--gold);color:var(--night);font-family:var(--fd);font-weight:700;padding:12px 26px;border-radius:12px;text-decoration:none;border:0;font-size:1rem;cursor:pointer;white-space:nowrap}
.cta:hover{background:var(--gold-2);color:#fff}
.cta:focus-visible,.book input:focus-visible{outline:3px solid #fff;outline-offset:2px}
.note{font-size:.85rem;color:#C9D1E6;grid-column:1/-1;margin:0}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin-top:10px}
.card{border:1px solid var(--line);border-radius:14px;padding:14px 16px;text-decoration:none;color:var(--ink);background:#fff;display:block;transition:border-color .15s}
.card:hover{border-color:var(--gold)}
.card b{display:block;font-family:var(--fd);color:var(--night);margin-bottom:4px}
.card small{color:var(--mute)}
.faq details{border-bottom:1px solid var(--line);padding:12px 0}
.faq summary{cursor:pointer;font-weight:500;color:var(--night);font-family:var(--fd)}
.faq p{margin:8px 0 0;color:#3a4256}
footer{margin-top:56px;border-top:1px solid var(--line);padding:28px 0;font-size:.85rem;color:var(--mute)}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
footer a{color:var(--mute);text-decoration:none;margin-inline-start:14px}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<div class="top"><div class="wrap">
  <a class="brand" href="/">فنادق <b>قريبة من</b> · عطلات</a>
  <a href="https://wa.me/966920033839">واتساب 920 033 839</a>
</div></div>
<main class="wrap"><slot /></main>
<footer><div class="wrap">
  <div>© 2026 عطلات — ترخيص وزارة السياحة 73105299 · س.ت 1010857948</div>
  <div><a href="https://www.otlaat.com/">otlaat.com</a><a href="https://hotels.otlaat.com/home">احجز فندق</a><a href="https://www.otlaat.com/packages">الباقات</a></div>
</div></footer>
</body>
</html>
