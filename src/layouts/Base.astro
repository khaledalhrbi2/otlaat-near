---
const { title, description, canonical, jsonld = [], image, citySlug } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = canonical ?? site + Astro.url.pathname;
const og = image ?? (citySlug ? `${site}/og/${citySlug}.jpg` : `${site}/og/default.jpg`);
import { cities } from '../lib/data.js';
const navCities = ['riyadh','jeddah','makkah','madinah','dubai','istanbul','london'].map(s => cities.find(c => c.slug === s));
const GULF = ['السعودية','الإمارات','قطر','البحرين','الكويت','مصر'];
const cols = { 'السعودية والخليج ومصر': cities.filter(c => GULF.includes(c.country)), 'تركيا وآسيا': cities.filter(c => ['تركيا','إندونيسيا'].includes(c.country)), 'أوروبا': cities.filter(c => !GULF.includes(c.country) && !['تركيا','إندونيسيا'].includes(c.country)) };
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="theme-color" content="#1f2752" />
<meta name="author" content="عطلات" />
<meta name="geo.region" content="SA" />
<link rel="alternate" hreflang="ar" href={url} />
<link rel="alternate" hreflang="x-default" href={url} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="عطلات — فنادق قريبة من" />
<meta property="og:locale" content="ar_SA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={og} />
<meta property="og:image:secure_url" content={og} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@otlaatcom" />
<meta name="twitter:creator" content="@otlaatcom" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={title} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Organization","name":"عطلات","alternateName":"Otlaat","url":site,"logo":`${site}/logo.svg`,"telephone":"+966920033839","address":{"@type":"PostalAddress","addressLocality":"Riyadh","addressCountry":"SA"},"sameAs":["https://x.com/otlaatcom","https://www.instagram.com/otlaat/","https://www.tiktok.com/@otlaat","https://www.youtube.com/@otlaat","https://www.snapchat.com/add/otlaat","https://www.facebook.com/otlaat"]})} />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"فنادق قريبة من — عطلات","url":site,"inLanguage":"ar"})} />
<style is:global>
:root{--orange:#f58824;--orange-2:#ff891e;--orange-soft:#fff3e6;--navy:#1f2752;--navy-2:#131830;--navy-soft:#eef0fa;--ink:#1a1a1a;--ink-2:#4a4f54;--line:#ececec;--bg:#ffffff;--bg-2:#fafafa;--radius:14px;--shadow:0 4px 24px rgba(26,26,26,.06);--shadow-2:0 12px 40px rgba(26,26,26,.10);--container:1240px;--font:"IBM Plex Sans Arabic",system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif}
*{box-sizing:border-box}
body{margin:0;font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.7;font-size:16px;-webkit-font-smoothing:antialiased}
h1,h2,h3{line-height:1.35;margin:0 0 .5em;color:var(--navy);font-weight:700}
h1{font-size:clamp(1.6rem,3.6vw,2.3rem)}
h2{font-size:1.3rem;margin-top:2.4rem}
a{color:var(--navy)}
.wrap{max-width:var(--container);margin:0 auto;padding:0 20px}
/* top bar */
.topbar{background:var(--navy);color:#fff;font-size:.82rem}
.topbar .wrap{display:flex;justify-content:space-between;align-items:center;min-height:38px;gap:12px}
.topbar a{color:#fff;text-decoration:none;font-weight:600}
.topbar .meta span{margin-inline-start:18px;opacity:.9}
/* header */
header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:900}
header .wrap{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:16px}
header img{height:44px}
header nav{display:flex;gap:22px;font-size:.93rem}
header nav a{text-decoration:none;color:var(--ink-2);font-weight:500}
header nav a:hover{color:var(--orange)}
.pill-nav{display:none}
@media(max-width:960px){header nav{display:none}}
/* crumbs */
.crumbs{font-size:.86rem;color:var(--ink-2);padding:18px 0 6px}
.crumbs a{color:var(--ink-2);text-decoration:none}.crumbs span{margin:0 .45em;opacity:.6}
/* hero */
.hero{max-width:820px;padding:10px 0 6px}
.eyebrow{display:inline-block;background:var(--orange-soft);color:var(--orange);border-radius:99px;padding:4px 14px;font-size:.82rem;font-weight:600;margin-bottom:12px}
.lede{font-size:1.02rem;color:var(--ink-2)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0}
.chip{background:var(--bg-2);border:1px solid var(--line);border-radius:99px;padding:6px 14px;font-size:.86rem;color:var(--ink);text-decoration:none;transition:all .15s}
a.chip:hover{border-color:var(--orange);color:var(--orange)}
.chip.ring{background:var(--navy-soft);border-color:#d6dbf2;color:var(--navy);font-weight:600}
/* booking card (white card like site search) */
.book{margin:24px 0 4px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-2);border:1px solid var(--line);padding:20px 22px;display:grid;grid-template-columns:repeat(3,1fr) auto;gap:14px;align-items:end}
@media(max-width:820px){.book{grid-template-columns:1fr 1fr}.book .cta{grid-column:1/-1}}
.book label{display:block;font-size:.8rem;color:var(--ink-2);margin-bottom:5px;font-weight:500}
.book input,.book select{width:100%;border:1px solid var(--line);background:var(--bg-2);color:var(--ink);border-radius:10px;padding:11px 12px;font-family:var(--font);font-size:.95rem}
.book input:focus-visible,.book select:focus-visible{outline:2px solid var(--orange);border-color:var(--orange)}
.cta{display:inline-flex;justify-content:center;align-items:center;background:var(--orange);color:#fff;font-weight:700;padding:13px 28px;border-radius:99px;text-decoration:none;border:0;font-size:1rem;cursor:pointer;white-space:nowrap;transition:background .15s;font-family:var(--font)}
.cta:hover{background:var(--orange-2)}
.cta:focus-visible{outline:3px solid var(--navy);outline-offset:2px}
.note{font-size:.82rem;color:var(--ink-2);grid-column:1/-1;margin:0}
.note b{color:var(--navy)}
.nights{font-size:.9rem;color:var(--ink-2);padding-bottom:11px}
/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-top:10px}
.pkg-banner{display:block;text-decoration:none;color:#fff;background:linear-gradient(135deg,var(--navy) 0%,#2e3a75 55%,var(--orange) 130%);border-radius:var(--radius);padding:26px 28px;margin:10px 0 16px;box-shadow:0 8px 24px rgba(31,39,82,.25);transition:transform .15s,box-shadow .15s;position:relative;overflow:hidden}
.pkg-banner:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(31,39,82,.35)}
.pkg-banner h2{margin:10px 0 8px;font-size:1.35rem;color:#fff;border:0;padding:0}
.pkg-banner p{margin:0 0 16px;color:#e8eaf6;font-size:.98rem;line-height:1.8}
.pkg-badge{display:inline-block;background:var(--orange);color:#fff;font-weight:700;font-size:.85rem;padding:5px 14px;border-radius:99px}
.pkg-cta-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.pkg-price-big{font-size:1.05rem;color:#ffe0c2}
.pkg-price-big b{font-size:1.35rem;color:#fff}
.pkg-btn{background:#fff;color:var(--navy);font-weight:800;padding:11px 22px;border-radius:99px;font-size:1rem}
@media(max-width:600px){.pkg-banner{padding:20px 18px}.pkg-banner h2{font-size:1.15rem}}
.pkg-line{margin:26px 0 6px;padding:14px 16px;border:1px dashed var(--orange);border-radius:var(--radius);background:#fff7ef;font-size:.95rem}
.pkg-line a{color:var(--navy)}
.card{border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;text-decoration:none;color:var(--ink);background:#fff;display:block;transition:all .15s;box-shadow:var(--shadow)}
.card:hover{border-color:var(--orange);transform:translateY(-2px);box-shadow:var(--shadow-2)}
.card b{display:block;color:var(--navy);margin-bottom:3px;font-size:1rem}
.card small{color:var(--ink-2)}
/* content + faq */
.prose{max-width:760px;color:var(--ink-2)}
.prose ul{padding-inline-start:1.2em}
.faq details{border:1px solid var(--line);border-radius:var(--radius);padding:14px 18px;margin-bottom:10px;background:#fff}
.faq summary{cursor:pointer;font-weight:600;color:var(--navy);list-style:none;display:flex;justify-content:space-between}
.faq summary::after{content:"+";color:var(--orange);font-size:1.3rem;line-height:1}
.faq details[open] summary::after{content:"–"}
.faq p{margin:10px 0 0;color:var(--ink-2)}
/* support + footer */
.support{margin-top:56px;background:var(--navy-soft);border-radius:var(--radius);padding:22px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.support b{color:var(--navy)}
.support a{color:var(--navy);text-decoration:none;font-weight:600;margin-inline-start:20px}
footer{margin-top:40px;background:var(--bg-2);border-top:1px solid var(--line);padding:36px 0 28px;font-size:.88rem;color:var(--ink-2)}
footer .cols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}
@media(max-width:820px){footer .cols{grid-template-columns:1fr 1fr}}
footer h5{margin:0 0 10px;color:var(--navy);font-size:.95rem}
footer a{display:block;color:var(--ink-2);text-decoration:none;margin-bottom:6px}
footer a:hover{color:var(--orange)}
footer img{height:40px;margin-bottom:10px}
.legal{border-top:1px solid var(--line);margin-top:28px;padding-top:18px;font-size:.8rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
.pay{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.pay img{height:22px;margin:0;background:#fff;border:1px solid var(--line);border-radius:6px;padding:2px 6px}
@media(prefers-reduced-motion:reduce){.card{transition:none}}
</style>
</head>
<body>
<div class="topbar"><div class="wrap">
  <div class="meta"><span>ترخيص وزارة السياحة 73105299</span><span>دعم عملاء 24/7</span><span>ضمان أفضل سعر</span></div>
  <a href="tel:+966920033839">+966 920 033 839</a>
</div></div>
<header><div class="wrap">
  <a href="/"><img src="/logo.svg" alt="عطلات — فنادق قريبة من" /></a>
  <nav>{navCities.map(c => <a href={`/${c.slug}/`}>{c.name_ar}</a>)}<a href="/#cities">كل المدن</a><a href="/budget/">حاسبة الميزانية</a></nav>
  <a class="cta" href="https://wa.me/966920033839" rel="nofollow" style="padding:9px 18px;font-size:.9rem">واتساب</a>
</div></header>
<main class="wrap"><slot />
<div class="support"><div><b>تحتاج مساعدة؟</b> دعم 24/7 على مدار الساعة</div><div><a href="tel:920033839">اتصل 920 033 839</a><a href="https://wa.me/966920033839" rel="nofollow">واتساب</a></div></div>
</main>
<footer><div class="wrap">
  <div class="cols">
    <div><img src="/logo.svg" alt="عطلات" /><p style="margin:0 0 8px">دليل الفنادق القريبة من المعالم والأحداث — من عطلات، منصة سعودية للحجوزات الفندقية مرخصة من وزارة السياحة منذ 2023.</p>
      <div class="pay">{['visa','mastercard','mada','apple-pay','tabby','tamara'].map(p => <img src={`/pay/${p}.svg`} alt={p} />)}</div></div>
    {Object.entries(cols).map(([t, list]) => <div><h5>{t}</h5>{list.map(c => <a href={`/${c.slug}/`}>فنادق {c.name_ar}</a>)}</div>)}
  </div>
  <div class="legal"><div>ترخيص وزارة السياحة 73105299 · السجل التجاري 1010857948 · الرقم الضريبي 302237464400003</div><div>© 2026 عطلات. جميع الحقوق محفوظة.</div></div>
</div></footer>
</body>
</html>
