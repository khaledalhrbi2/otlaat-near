---
import Base from '../../layouts/Base.astro';
import BookingBar from '../../components/BookingBar.astro';
import { cities, loadCity, loadContent, fallbackContent, poiPath } from '../../lib/data.js';
export function getStaticPaths(){
  return cities.flatMap(c => { const city = loadCity(c.slug); return city.pois.map(p => ({ params:{ city:c.slug, page: poiPath(city,p).split('/')[2] }, props:{ poiSlug:p.slug } })); });
}
const city = loadCity(Astro.params.city);
const poi = city.pois.find(p => p.slug === Astro.props.poiSlug);
const content = loadContent(city.slug, poi.slug) ?? fallbackContent(city, poi);
const nb = poi.neighbours.map(n => ({ ...n, ...city.pois.find(p => p.slug === n.slug) }));
const intent = poi.intents.includes('family') ? 'family' : poi.intents.includes('b2b') ? 'b2b' : 'default';
const url = `${Astro.site}${poiPath(city,poi).slice(1)}`;
const jsonld = [
  { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
    {"@type":"ListItem","position":1,"name":"الرئيسية","item":Astro.site},
    {"@type":"ListItem","position":2,"name":city.name_ar,"item":`${Astro.site}${city.slug}/`},
    {"@type":"ListItem","position":3,"name":`قريب من ${poi.name_ar}`,"item":url}]},
  { "@context":"https://schema.org","@type":"Place","name":poi.name_ar,"alternateName":poi.name_en,"geo":{"@type":"GeoCoordinates","latitude":poi.lat,"longitude":poi.lng},"address":{"@type":"PostalAddress","addressLocality":city.name_en,"addressCountry":city.country}},
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":content.faq.map(f => ({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) },
];
jsonld.push({ "@context":"https://schema.org","@type":"Service","name":`حجز فنادق قريبة من ${poi.name_ar}`,"provider":{"@type":"Organization","name":"عطلات"},"areaServed":city.name_ar,"offers":{"@type":"Offer","priceCurrency":"SAR","availability":"https://schema.org/InStock","acceptedPaymentMethod":["http://purl.org/goodrelations/v1#ByInvoice","http://purl.org/goodrelations/v1#PaymentMethodCreditCard"],"description":"تقسيط على 4 دفعات عبر تابي وتمارا · مدى · Apple Pay · إلغاء مجاني على أغلب الحجوزات"} });
if (poi.event) jsonld.push({ "@context":"https://schema.org","@type":"Event","name":poi.name_ar,"startDate":poi.event.start,"endDate":poi.event.end,"location":{"@type":"Place","name":poi.poi_label,"geo":{"@type":"GeoCoordinates","latitude":poi.lat,"longitude":poi.lng}},"eventStatus":"https://schema.org/EventScheduled" });
---
<Base title={content.seo_title ?? `${content.title} — عطلات`} description={content.meta} jsonld={jsonld} citySlug={city.slug}>
  <nav class="crumbs"><a href="/">الرئيسية</a><span>›</span><a href={`/${city.slug}/`}>{city.name_ar}</a><span>›</span>قريب من {poi.name_ar}</nav>
  <div class="hero">
    <div>
      <span class="eyebrow">فنادق قريبة من · {city.name_ar}</span>
      <h1>{content.title}</h1>
      <p class="lede">{content.intro}</p>
      <div class="chips">
        <span class="chip ring">نطاق {poi.prox_km} كم</span>
        {poi.nearest_metro && <span class="chip">🚇 {poi.type === 'metro' ? poi.nearest_metro : 'أقرب محطة: ' + poi.nearest_metro}</span>}
        {poi.event && <span class="chip">📅 {poi.event.start} → {poi.event.end}</span>}
        {poi.intents.slice(0,3).map(i => <span class="chip">{({family:'للعوائل',apartments:'شقق فندقية','5-star':'5 نجوم',budget:'اقتصادي',couples:'للأزواج',corporate:'رجال أعمال',transit:'ترانزيت',beach:'شاطئ',villa:'فلل',shopping:'تسوق','haram-view':'مطل على الحرم','bosphorus-view':'مطل على البسفور',halal:'حلال',nature:'طبيعة',cliff:'جرف',b2b:'مجموعات',medical:'مرافقة مرضى'})[i] ?? i}</span>)}
      </div>
    </div>
  </div>
  <BookingBar city={city} poi={poi} intent={intent} />
  <section class="prose">
    <h2>عن {poi.name_ar}</h2>
    <p>{content.about}</p>
    {content.tips && <ul>{content.tips.map(t => <li>{t}</li>)}</ul>}
  </section>
  {(content.sections ?? []).map(sec => <section class="prose"><h2>{sec.h2}</h2><p>{sec.p}</p></section>)}
  <section>
    <h2>معالم قريبة من {poi.name_ar}</h2>
    <div class="grid">{nb.map(n => <a class="card" href={poiPath(city,n)}><b>{n.name_ar}</b><small>{n.km} كم · ضمن {n.prox_km} كم</small></a>)}</div>
  </section>
  <section class="faq">
    <h2>أسئلة شائعة</h2>
    {content.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</Base>
