---
/** شريط الحجز: التواريخ تُحسب في المتصفح عبر bookingLink.js */
const { city, poi = null, intent = 'default' } = Astro.props;
const payload = { city: { code: city.code, name_ar: city.name_ar, slug: city.slug, lat: city.lat, lng: city.lng, default_prox: city.default_prox, default_nights: city.default_nights, date_profile: city.date_profile },
  poi: poi ? { slug: poi.slug, q: poi.q, lat: poi.lat, lng: poi.lng, prox_km: poi.prox_km, poi_label: poi.poi_label, event: poi.event ?? null } : null, intent };
---
<form class="book" data-book={JSON.stringify(payload)} onsubmit="return false">
  <div><label for="ci">تسجيل الوصول</label><input id="ci" name="ci" type="date" /></div>
  <div><label for="co">تسجيل المغادرة</label><input id="co" name="co" type="date" /></div>
  <div><label for="rp">الغرف</label><select id="rp" name="rp"><option value="1">غرفة</option><option value="2">غرفتان</option><option value="3">3 غرف</option><option value="4">4 غرف</option><option value="5">5 غرف</option></select></div>
  <div class="nights" data-nights></div>
  <a class="cta" data-cta href={`/go/${city.slug}${poi ? "/" + poi.slug : ""}`} rel="nofollow noopener" target="_blank">تحقق من التوفر على عطلات</a>
  <p class="note"><b>{poi ? `النتائج ضمن ${poi.prox_km} كم من ${poi.name_ar}` : `كل فنادق ${city.name_ar}`}</b> · أسعار شاملة الضرائب · إلغاء مجاني على أغلب الحجوزات · تقسيط تابي وتمارا</p>
</form>
<script>
  import { computeDates } from '../lib/bookingLink.js';
  const iso = d => d.toISOString().slice(0,10);
    document.querySelectorAll('form.book').forEach(form => {
    const { city, poi, intent } = JSON.parse(form.dataset.book);
    const ci = form.querySelector('#ci'), co = form.querySelector('#co'), rp = form.querySelector('#rp'), cta = form.querySelector('[data-cta]'), n = form.querySelector('[data-nights]');
    const d = computeDates(city, poi);
    ci.value = iso(d.checkin); co.value = iso(d.checkout); ci.min = iso(new Date());
    if (intent === 'family') rp.value = '2'; if (intent === 'b2b') rp.value = '5';
    const sync = () => {
      if (co.value <= ci.value) { const x = new Date(ci.value); x.setDate(x.getDate()+1); co.value = iso(x); }
      const nights = Math.round((new Date(co.value)-new Date(ci.value))/864e5);
      n.textContent = `${nights} ${nights===1?'ليلة':nights===2?'ليلتان':nights<=10?'ليالٍ':'ليلة'}`;
      cta.href = `/go/${city.slug}${poi ? '/' + poi.slug : ''}?ci=${ci.value}&co=${co.value}&rp=${rp.value}${intent !== 'default' ? '&i=' + intent : ''}`;
    };
    [ci,co,rp].forEach(el => el.addEventListener('change', sync)); sync();
  });
</script>
