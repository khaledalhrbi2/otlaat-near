---
/** قائمة "أفضل الفنادق" — كل عنصر يفتح بحث عطلات بالاسم عبر /go/ */
const { city, hotels, poi = null, heading, intent = 'default' } = Astro.props;
const go = (h) => `/go/${city.slug}${poi ? '/' + poi.slug : ''}?h=${encodeURIComponent(h.name)}${intent !== 'default' ? '&i=' + intent : ''}`;
const site = Astro.site?.toString() ?? '';
const jsonld = { "@context":"https://schema.org","@type":"ItemList","name":heading,"numberOfItems":hotels.length,"itemListElement":hotels.map((h,i)=>({"@type":"ListItem","position":i+1,"item":{"@type":"Hotel","name":h.name,"alternateName":h.name_ar||undefined,"starRating":{"@type":"Rating","ratingValue":h.stars},"geo":{"@type":"GeoCoordinates","latitude":h.lat,"longitude":h.lng},"address":{"@type":"PostalAddress","addressLocality":city.name_en,"addressCountry":city.country}}})) };
---
{hotels.length > 0 && <section class="hotels">
  <h2>{heading}</h2>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <ol class="hl">
    {hotels.map((h,i) => <li>
      <span class="n">{i+1}</span>
      <div class="b"><b>{h.name_ar || h.name}</b>{h.name_ar && <small dir="ltr">{h.name}</small>}
        <span class="m">{'★'.repeat(h.stars)}{h.km !== undefined && <span> · {h.km.toFixed(1)} كم{poi ? ` من ${poi.name_ar}` : ''}</span>}{h.tags.includes('beach') && ' · شاطئ'}{h.tags.includes('pool') && ' · مسبح'}{h.tags.includes('apartments') && ' · شقق'}</span></div>
      <a class="cta sm" href={go(h)} rel="nofollow noopener" target="_blank">شاهد السعر</a>
    </li>)}
  </ol>
  <p class="note" style="margin-top:8px">الترتيب حسب المسافة وتقييمات النزلاء. الأسعار تظهر بتواريخك شاملة الضرائب على عطلات.</p>
</section>}
<style>
.hl{list-style:none;padding:0;margin:10px 0 0;display:grid;gap:8px}
.hl li{display:flex;align-items:center;gap:14px;border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;background:#fff}
.hl .n{width:30px;height:30px;border-radius:50%;background:var(--navy-soft);color:var(--navy);font-weight:700;display:grid;place-items:center;flex:none;font-size:.9rem}
.hl .b{flex:1;min-width:0}.hl b{display:block;color:var(--navy)}.hl small{color:var(--ink-2);font-size:.78rem}.hl .m{display:block;color:var(--orange);font-size:.82rem}.hl .m span{color:var(--ink-2)}
.cta.sm{padding:8px 16px;font-size:.85rem}
@media(max-width:600px){.hl li{flex-wrap:wrap}.cta.sm{width:100%}}
</style>
